  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingPlan          BillingPlan            @relation(fields: [billingPlanId], references: [id], onDelete: Restrict)
  createdByUser        User?                  @relation("PlanSubscriptionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId])
  @@index([organizationId, status])
  @@index([billingPlanId, updatedAt])
  @@map("plan_subscriptions")
}

model StripeEventLog {
  id               String                      @id @default(uuid()) @db.Uuid
  stripeEventId    String                      @unique
  eventType        String
  organizationId   String?                     @db.Uuid
  processingStatus StripeEventProcessingStatus @default(pending)
  processedAt      DateTime?
  errorMessage     String?
  payload          Json
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  organization     Organization?               @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([processingStatus, createdAt])
  @@map("stripe_event_logs")
}

model UsageMeter {
  id                     String         @id @default(uuid()) @db.Uuid
  organizationId         String         @db.Uuid
  meterType              UsageMeterType
  usageValue             Int
  measurementWindowStart DateTime
  measurementWindowEnd   DateTime
  sourceType             String
  sourceReference        String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, meterType, measurementWindowStart, measurementWindowEnd])
  @@index([organizationId, meterType, measurementWindowEnd])
  @@map("usage_meters")
}

model IntegrationConnection {
  id                String                      @id @default(uuid()) @db.Uuid
  organizationId    String                      @db.Uuid
  integrationType   IntegrationType
  name              String
  status            IntegrationConnectionStatus @default(active)
  configJson        Json
  credentialsRef    String?
  lastSyncAt        DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  syncRuns          IntegrationSyncRun[]
  failedRecords     IntegrationFailedRecord[]
  sourceRecords     IntegrationSourceRecord[]

  @@index([organizationId, integrationType, status])
  @@index([organizationId, updatedAt])
  @@map("integration_connections")
}

model IntegrationSyncRun {
  id                      String               @id @default(uuid()) @db.Uuid
  organizationId          String               @db.Uuid
  integrationConnectionId String               @db.Uuid
  requestedByUserId       String?              @db.Uuid
  direction               IntegrationDirection
  syncType                IntegrationSyncType
  status                  IntegrationSyncStatus @default(pending)
  startedAt               DateTime
  completedAt             DateTime?
  processedCount          Int                  @default(0)
  successCount            Int                  @default(0)
  failureCount            Int                  @default(0)
  checkpoint              Json?
  errorSummary            Json?
  inputPayload            Json?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  organization            Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integrationConnection   IntegrationConnection @relation(fields: [integrationConnectionId], references: [id], onDelete: Cascade)
  requestedByUser         User?                @relation("IntegrationSyncRunRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  failedRecords           IntegrationFailedRecord[]
  sourceRecords           IntegrationSourceRecord[]

  @@index([organizationId, integrationConnectionId, createdAt])
  @@index([organizationId, status, startedAt])
  @@map("integration_sync_runs")
}

model IntegrationFailedRecord {
  id                      String                @id @default(uuid()) @db.Uuid
  organizationId          String                @db.Uuid
  integrationConnectionId String                @db.Uuid
  syncRunId               String?               @db.Uuid
  recordType              String
  sourceReference         String?
  payload                 Json
  errorMessage            String
  createdAt               DateTime              @default(now())
  resolvedAt              DateTime?
  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integrationConnection   IntegrationConnection @relation(fields: [integrationConnectionId], references: [id], onDelete: Cascade)
  syncRun                 IntegrationSyncRun?   @relation(fields: [syncRunId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, integrationConnectionId, createdAt])
  @@index([syncRunId])
  @@map("integration_failed_records")
}

model IntegrationSourceRecord {
  id                      String                @id @default(uuid()) @db.Uuid
  organizationId          String                @db.Uuid
  integrationConnectionId String                @db.Uuid
  syncRunId               String?               @db.Uuid
  syncType                IntegrationSyncType
  recordType              String
  externalReference       String
  payloadChecksum         String
  canonicalEntityType     String?
  canonicalEntityId       String?
  firstProcessedAt        DateTime              @default(now())
  lastProcessedAt         DateTime              @default(now())
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integrationConnection   IntegrationConnection @relation(fields: [integrationConnectionId], references: [id], onDelete: Cascade)
  syncRun                 IntegrationSyncRun?   @relation(fields: [syncRunId], references: [id], onDelete: SetNull)

  @@unique([organizationId, integrationConnectionId, recordType, externalReference])
  @@index([organizationId, syncType, lastProcessedAt])
  @@index([syncRunId])
  @@map("integration_source_records")
}

model WorkerRun {
  id            String          @id @default(uuid()) @db.Uuid
  workerType    WorkerType
  status        WorkerRunStatus
  correlationId String          @db.Uuid
  startedAt     DateTime
  completedAt   DateTime?
  processedCount Int            @default(0)
  errorMessage  String?
  metadata      Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([workerType, startedAt])
  @@index([workerType, status, createdAt])
  @@map("worker_runs")
}
