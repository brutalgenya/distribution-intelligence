generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  owner
  admin
  operator
  viewer
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum SkuStatus {
  active
  inactive
}

enum LocationType {
  warehouse
  store
  staging
  transit
}

enum LocationStatus {
  active
  inactive
}

enum InventoryMovementType {
  receipt
  adjustment
  reservation
  reservation_release
  transfer_out
  transfer_in
}

enum InventoryReservationStatus {
  active
  released
}

enum InventoryTransferStatus {
  requested
  completed
}

enum SalesImportRunStatus {
  completed
  failed
}

enum CustomerOrderStatus {
  open
  cancelled
}

enum ForecastScopeType {
  sku
  sku_location
  organization
}

enum ForecastJobStatus {
  pending
  running
  completed
  failed
}

enum ForecastModelType {
  baseline_recent_average
}

enum DemandSignalType {
  historical_sale
  customer_order
  customer_order_cancellation
  manual_import
}

enum SupplierStatus {
  active
  inactive
}

enum PurchaseOrderStatus {
  draft
  submitted
  partially_received
  received
  delayed
  cancelled
}

enum PolicyType {
  replenishment
  allocation
  exception
}

enum PolicyStatus {
  draft
  active
  archived
}

enum DecisionType {
  replenishment
  allocation
  exception
}

enum DecisionStatus {
  proposed
  awaiting_approval
  approved
  rejected
  execution_requested
  executing
  executed
  execution_failed
  superseded
  dismissed
}

enum AutomationTier {
  observe
  recommend
  draft_only
  auto_execute
}

enum ApprovalTaskStatus {
  pending
  approved
  rejected
  cancelled
}

enum ApprovalTaskPurpose {
  decision_review
  execution_gate
}

enum ExecutionTaskType {
  create_purchase_order
  create_transfer_order
  notify_operator
}

enum ExecutionTargetSystem {
  internal_supply
  internal_notification
}

enum ExecutionTaskStatus {
  pending
  running
  succeeded
  failed
  dead_lettered
  cancelled
}

enum ExecutionAttemptStatus {
  running
  succeeded
  failed
}

enum IdempotencyScopeType {
  execution_task
}

enum IdempotencyKeyStatus {
  pending
  succeeded
  failed
}

enum OperatorOverrideType {
  manual_approve
  manual_reject
  manual_cancel_execution
  manual_retry
  manual_close_exception
  manual_request_execution
  manual_request_approval
}

enum DecisionOutcomeStatus {
  pending
  computed
  insufficient_data
}

enum OutcomeScopeType {
  organization
  sku_location
}

enum AiModelType {
  forecast_enhancement
  anomaly_scoring
  decision_explanation
}

enum ModelRegistryStatus {
  active
  inactive
  deprecated
}

enum AiRunType {
  forecast_enhancement
  anomaly_scoring
  decision_explanation
}

enum AiRunStatus {
  pending
  succeeded
  failed
  degraded
}

enum AnomalySeverity {
  low
  medium
  high
}

enum WorkerType {
  forecast
  execution
  outcomes
  integration
}

enum WorkerRunStatus {
  running
  succeeded
  failed
}

enum BillingPlanStatus {
  active
  inactive
  archived
}

enum BillingInterval {
  monthly
  yearly
}

enum PlanSubscriptionStatus {
  trialing
  active
  past_due
  cancelled
  incomplete
  unpaid
}

enum StripeEventProcessingStatus {
  pending
  processed
  failed
}

enum UsageMeterType {
  users
  skus
  forecast_jobs
  ai_runs
  executed_automation_actions
}

enum IntegrationType {
  erp
  wms
  csv_import
  manual_bridge
}

enum IntegrationConnectionStatus {
  active
  inactive
  error
}

enum IntegrationDirection {
  inbound
  outbound
}

enum IntegrationSyncType {
  catalog_import
  demand_import
  inventory_import
}

enum IntegrationSyncStatus {
  pending
  running
  completed
  failed
  partial
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  email                   String                   @unique
  displayName             String
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  memberships             OrganizationMembership[]
  sentInvitations         OrganizationInvitation[] @relation("InvitationInvitedBy")
  acceptedInvitations     OrganizationInvitation[] @relation("InvitationAcceptedBy")
  auditEvents             AuditEvent[]             @relation("AuditActor")
  inventoryMovements      InventoryMovement[]      @relation("InventoryMovementCreatedBy")
  inventoryReservations   InventoryReservation[]   @relation("InventoryReservationCreatedBy")
  requestedTransfers      InventoryTransfer[]      @relation("InventoryTransferRequestedBy")
  completedTransfers      InventoryTransfer[]      @relation("InventoryTransferCompletedBy")
  salesImportRuns         SalesImportRun[]         @relation("SalesImportRunCreatedBy")
  customerOrders          CustomerOrder[]          @relation("CustomerOrderCreatedBy")
  cancelledOrders         CustomerOrder[]          @relation("CustomerOrderCancelledBy")
  forecastJobs            ForecastJob[]            @relation("ForecastJobRequestedBy")
  purchaseOrders          PurchaseOrder[]          @relation("PurchaseOrderCreatedBy")
  createdPolicies         Policy[]                 @relation("PolicyCreatedBy")
  createdDecisions        Decision[]               @relation("DecisionCreatedBy")
  requestedApprovalTasks  ApprovalTask[]           @relation("ApprovalTaskRequestedBy")
  assignedApprovalTasks   ApprovalTask[]           @relation("ApprovalTaskAssignedTo")
  decidedApprovalTasks    ApprovalTask[]           @relation("ApprovalTaskDecidedBy")
  requestedExecutionTasks ExecutionTask[]          @relation("ExecutionTaskRequestedBy")
  operatorOverrides       OperatorOverride[]       @relation("OperatorOverrideCreatedBy")
  createdSubscriptions    PlanSubscription[]       @relation("PlanSubscriptionCreatedBy")
  requestedIntegrationSyncRuns IntegrationSyncRun[] @relation("IntegrationSyncRunRequestedBy")

  @@map("users")
}

model Organization {
  id                           String                        @id @default(uuid()) @db.Uuid
  name                         String
  slug                         String                        @unique
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  memberships                  OrganizationMembership[]
  invitations                  OrganizationInvitation[]
  entitlements                 Entitlement[]
  auditEvents                  AuditEvent[]
  outboxEvents                 OutboxEvent[]
  skus                         Sku[]
  locations                    Location[]
  inventoryPositions           InventoryPosition[]
  inventoryMovements           InventoryMovement[]
  inventoryReservations        InventoryReservation[]
  inventoryTransfers           InventoryTransfer[]
  salesImportRuns              SalesImportRun[]
  historicalSales              HistoricalSale[]
  customerOrders               CustomerOrder[]
  demandSignals                DemandSignal[]
  forecastJobs                 ForecastJob[]
  forecastResults              ForecastResult[]
  suppliers                    Supplier[]
  supplierSkus                 SupplierSku[]
  supplierLeadTimeStats        SupplierLeadTimeStat[]
  supplierPerformanceSnapshots SupplierPerformanceSnapshot[]
  purchaseOrders               PurchaseOrder[]
  policies                     Policy[]
  decisions                    Decision[]
  approvalTasks                ApprovalTask[]
  executionTasks               ExecutionTask[]
  executionAttempts            ExecutionAttempt[]
  idempotencyKeys              IdempotencyKey[]
  operatorOverrides            OperatorOverride[]
  decisionOutcomes             DecisionOutcome[]
  stockoutIncidents            StockoutIncident[]
  fillRateMeasurements         FillRateMeasurement[]
  forecastErrorMeasurements    ForecastErrorMeasurement[]
  inventoryCostSnapshots       InventoryCostSnapshot[]
  policyEffectivenessSummaries PolicyEffectivenessSummary[]
  aiRuns                       AiRun[]
  anomalyScores                AnomalyScore[]
  decisionExplanations         DecisionExplanation[]
  enhancedForecastResults      EnhancedForecastResult[]
  subscriptions                PlanSubscription[]
  stripeEventLogs              StripeEventLog[]
  usageMeters                  UsageMeter[]
  integrationConnections       IntegrationConnection[]
  integrationSyncRuns          IntegrationSyncRun[]
  integrationFailedRecords     IntegrationFailedRecord[]
  integrationSourceRecords     IntegrationSourceRecord[]

  @@map("organizations")
}

model Role {
  id          String                   @id @default(uuid()) @db.Uuid
  code        RoleCode                 @unique
  name        String
  description String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  memberships OrganizationMembership[]
  invitations OrganizationInvitation[]

  @@map("roles")
}

model OrganizationMembership {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  roleId         String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_memberships")
}

model OrganizationInvitation {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  email            String
  roleId           String           @db.Uuid
  token            String           @unique
  invitedByUserId  String           @db.Uuid
  acceptedByUserId String?          @db.Uuid
  status           InvitationStatus @default(pending)
  expiresAt        DateTime
  acceptedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role             Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy        User             @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy       User?            @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, email])
  @@map("organization_invitations")
}

model Entitlement {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  key            String
  value          Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("entitlements")
}

model AuditEvent {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  actorUserId    String?       @db.Uuid
  eventType      String
  entityType     String
  entityId       String
  payload        Json
  createdAt      DateTime      @default(now())
  correlationId  String        @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorUser      User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([correlationId])
  @@map("audit_events")
}

model OutboxEvent {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String?       @db.Uuid
  eventType       String
  aggregateType   String
  aggregateId     String
  payload         Json
  occurredAt      DateTime      @default(now())
  publishedAt     DateTime?
  publishAttempts Int           @default(0)
  lastError       String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([publishedAt, occurredAt])
  @@map("outbox_events")
}

model Sku {
  id                        String                     @id @default(uuid()) @db.Uuid
  organizationId            String                     @db.Uuid
  skuCode                   String
  name                      String
  description               String?
  baseUom                   String
  packSize                  Int
  status                    SkuStatus                  @default(active)
  metadata                  Json?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  organization              Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryPositions        InventoryPosition[]
  inventoryMovements        InventoryMovement[]
  inventoryReservations     InventoryReservation[]
  inventoryTransfers        InventoryTransfer[]
  historicalSales           HistoricalSale[]
  customerOrderLines        CustomerOrderLine[]
  demandSignals             DemandSignal[]
  forecastResults           ForecastResult[]
  supplierSkus              SupplierSku[]
  supplierLeadTimeStats     SupplierLeadTimeStat[]
  purchaseOrderLines        PurchaseOrderLine[]
  decisions                 Decision[]
  stockoutIncidents         StockoutIncident[]
  fillRateMeasurements      FillRateMeasurement[]
  forecastErrorMeasurements ForecastErrorMeasurement[]
  inventoryCostSnapshots    InventoryCostSnapshot[]
  enhancedForecastResults   EnhancedForecastResult[]

  @@unique([organizationId, skuCode])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("skus")
}

model Location {
  id                         String                     @id @default(uuid()) @db.Uuid
  organizationId             String                     @db.Uuid
  code                       String
  name                       String
  type                       LocationType
  status                     LocationStatus             @default(active)
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  organization               Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryPositions         InventoryPosition[]
  inventoryMovements         InventoryMovement[]
  inventoryReservations      InventoryReservation[]
  sourceTransfers            InventoryTransfer[]        @relation("InventoryTransferSourceLocation")
  destinationTransfers       InventoryTransfer[]        @relation("InventoryTransferDestinationLocation")
  historicalSales            HistoricalSale[]
  customerOrderLines         CustomerOrderLine[]
  demandSignals              DemandSignal[]
  forecastResults            ForecastResult[]
  expectedPurchaseOrderLines PurchaseOrderLine[]        @relation("PurchaseOrderLineExpectedLocation")
  decisions                  Decision[]
  stockoutIncidents          StockoutIncident[]
  fillRateMeasurements       FillRateMeasurement[]
  forecastErrorMeasurements  ForecastErrorMeasurement[]
  inventoryCostSnapshots     InventoryCostSnapshot[]
  enhancedForecastResults    EnhancedForecastResult[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("locations")
}

model Supplier {
  id                   String                        @id @default(uuid()) @db.Uuid
  organizationId       String                        @db.Uuid
  code                 String
  name                 String
  status               SupplierStatus                @default(active)
  contactEmail         String?
  contactPhone         String?
  metadata             Json?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  organization         Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierSkus         SupplierSku[]
  leadTimeStats        SupplierLeadTimeStat[]
  performanceSnapshots SupplierPerformanceSnapshot[]
  purchaseOrders       PurchaseOrder[]
  decisions            Decision[]

  @@unique([organizationId, code])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, updatedAt])
  @@map("suppliers")
}

model SupplierSku {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  supplierId      String       @db.Uuid
  skuId           String       @db.Uuid
  supplierSkuCode String?
  isPrimary       Boolean      @default(false)
  minOrderQty     Int          @default(1)
  casePackQty     Int?
  unitCost        Decimal?     @db.Decimal(12, 2)
  leadTimeDays    Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier        Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  sku             Sku          @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([organizationId, supplierId, skuId])
  @@index([organizationId, supplierId, updatedAt])
  @@index([organizationId, skuId, updatedAt])
  @@index([organizationId, skuId, isPrimary])
  @@map("supplier_skus")
}

model SupplierLeadTimeStat {
  id                       String       @id @default(uuid()) @db.Uuid
  organizationId           String       @db.Uuid
  supplierId               String       @db.Uuid
  skuId                    String       @db.Uuid
  sampleCount              Int
  averageLeadTimeDays      Float
  minLeadTimeDays          Int
  maxLeadTimeDays          Int
  lastObservedLeadTimeDays Int
  lastObservedAt           DateTime
  updatedAt                DateTime     @updatedAt
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier                 Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  sku                      Sku          @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([organizationId, supplierId, skuId])
  @@index([organizationId, supplierId, updatedAt])
  @@index([organizationId, skuId, updatedAt])
  @@map("supplier_lead_time_stats")
}

model SupplierPerformanceSnapshot {
  id                     String       @id @default(uuid()) @db.Uuid
  organizationId         String       @db.Uuid
  supplierId             String       @db.Uuid
  totalPurchaseOrders    Int
  delayedPurchaseOrders  Int
  receivedPurchaseOrders Int
  averageLeadTimeDays    Float?
  lastReceiptAt          DateTime?
  updatedAt              DateTime     @updatedAt
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier               Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([organizationId, supplierId])
  @@index([organizationId, supplierId, updatedAt])
  @@map("supplier_performance_snapshots")
}

model InventoryPosition {
  id                    String       @id @default(uuid()) @db.Uuid
  organizationId        String       @db.Uuid
  skuId                 String       @db.Uuid
  locationId            String       @db.Uuid
  onHandQty             Int          @default(0)
  reservedQty           Int          @default(0)
  inTransitQty          Int          @default(0)
  availableToPromiseQty Int          @default(0)
  safetyStockQty        Int          @default(0)
  reorderPointQty       Int          @default(0)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku                   Sku          @relation(fields: [skuId], references: [id], onDelete: Cascade)
  location              Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, skuId, locationId])
  @@index([organizationId, updatedAt])
  @@index([organizationId, skuId])
  @@index([organizationId, locationId])
  @@map("inventory_positions")
}

model InventoryMovement {
  id              String                @id @default(uuid()) @db.Uuid
  organizationId  String                @db.Uuid
  skuId           String                @db.Uuid
  locationId      String                @db.Uuid
  movementType    InventoryMovementType
  quantity        Int
  referenceType   String
  referenceId     String
  notes           String?
  createdByUserId String                @db.Uuid
  createdAt       DateTime              @default(now())
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku             Sku                   @relation(fields: [skuId], references: [id], onDelete: Cascade)
  location        Location              @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdByUser   User                  @relation("InventoryMovementCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, skuId, locationId, createdAt])
  @@index([organizationId, referenceType, referenceId])
  @@map("inventory_movements")
}

model InventoryReservation {
  id              String                     @id @default(uuid()) @db.Uuid
  organizationId  String                     @db.Uuid
  skuId           String                     @db.Uuid
  locationId      String                     @db.Uuid
  quantity        Int
  status          InventoryReservationStatus @default(active)
  referenceType   String
  referenceId     String
  notes           String?
  createdByUserId String                     @db.Uuid
  createdAt       DateTime                   @default(now())
  releasedAt      DateTime?
  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku             Sku                        @relation(fields: [skuId], references: [id], onDelete: Cascade)
  location        Location                   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdByUser   User                       @relation("InventoryReservationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, createdAt])
  @@index([organizationId, skuId, locationId, status])
  @@index([organizationId, referenceType, referenceId])
  @@map("inventory_reservations")
}

model InventoryTransfer {
  id                    String                  @id @default(uuid()) @db.Uuid
  organizationId        String                  @db.Uuid
  skuId                 String                  @db.Uuid
  sourceLocationId      String                  @db.Uuid
  destinationLocationId String                  @db.Uuid
  quantity              Int
  status                InventoryTransferStatus @default(requested)
  referenceType         String?
  referenceId           String?
  notes                 String?
  requestedByUserId     String                  @db.Uuid
  completedByUserId     String?                 @db.Uuid
  createdAt             DateTime                @default(now())
  completedAt           DateTime?
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku                   Sku                     @relation(fields: [skuId], references: [id], onDelete: Cascade)
  sourceLocation        Location                @relation("InventoryTransferSourceLocation", fields: [sourceLocationId], references: [id], onDelete: Cascade)
  destinationLocation   Location                @relation("InventoryTransferDestinationLocation", fields: [destinationLocationId], references: [id], onDelete: Cascade)
  requestedByUser       User                    @relation("InventoryTransferRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  completedByUser       User?                   @relation("InventoryTransferCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([organizationId, skuId, status])
  @@index([organizationId, sourceLocationId, status])
  @@index([organizationId, destinationLocationId, status])
  @@map("inventory_transfers")
}

model SalesImportRun {
  id              String               @id @default(uuid()) @db.Uuid
  organizationId  String               @db.Uuid
  createdByUserId String               @db.Uuid
  status          SalesImportRunStatus
  totalRows       Int
  acceptedRows    Int
  duplicateRows   Int                  @default(0)
  rejectedRows    Int
  errorSummary    Json?
  startedAt       DateTime
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser   User                 @relation("SalesImportRunCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  historicalSales HistoricalSale[]

  @@index([organizationId, status, createdAt])
  @@map("sales_import_runs")
}

model HistoricalSale {
  id               String         @id @default(uuid()) @db.Uuid
  organizationId   String         @db.Uuid
  salesImportRunId String         @db.Uuid
  skuId            String         @db.Uuid
  locationId       String         @db.Uuid
  quantity         Int
  soldAt           DateTime
  sourceType       String
  sourceReference  String
  rowFingerprint   String
  createdAt        DateTime       @default(now())
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesImportRun   SalesImportRun @relation(fields: [salesImportRunId], references: [id], onDelete: Cascade)
  sku              Sku            @relation(fields: [skuId], references: [id], onDelete: Cascade)
  location         Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, rowFingerprint])
  @@index([organizationId, skuId, soldAt])
  @@index([organizationId, locationId, soldAt])
  @@index([organizationId, sourceType, sourceReference])
  @@map("historical_sales")
}

model CustomerOrder {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @db.Uuid
  orderNumber       String
  status            CustomerOrderStatus @default(open)
  customerReference String?
  orderedAt         DateTime
  createdByUserId   String              @db.Uuid
  cancelledAt       DateTime?
  cancelledByUserId String?             @db.Uuid
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser     User                @relation("CustomerOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  cancelledByUser   User?               @relation("CustomerOrderCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  lines             CustomerOrderLine[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, orderedAt])
  @@map("customer_orders")
}

model CustomerOrderLine {
  id         String        @id @default(uuid()) @db.Uuid
  orderId    String        @db.Uuid
  skuId      String        @db.Uuid
  locationId String        @db.Uuid
  quantity   Int
  unitPrice  Decimal?      @db.Decimal(12, 2)
  createdAt  DateTime      @default(now())
  order      CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku        Sku           @relation(fields: [skuId], references: [id], onDelete: Restrict)
  location   Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([skuId])
  @@index([locationId])
