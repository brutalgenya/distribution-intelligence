APP_ENV=local
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wholesale_ai_platform
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wholesale_ai_platform_test
DEFAULT_INVITATION_TTL_HOURS=168
DEFAULT_TRIAL_PERIOD_DAYS=14
BILLING_PROVIDER=mock
APP_BASE_URL=http://localhost:4000
BILLING_CHECKOUT_SUCCESS_URL=http://localhost:4000/billing/success
BILLING_CHECKOUT_CANCEL_URL=http://localhost:4000/billing/cancel
BILLING_PORTAL_RETURN_URL=http://localhost:4000/settings/billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=https://api.stripe.com
HTTP_BODY_LIMIT_BYTES=262144
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_CONNECTION_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=72000
EXTERNAL_REQUEST_TIMEOUT_MS=10000
BILLING_WEBHOOK_MAX_BYTES=65536
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BILLING_MUTATIONS=12
RATE_LIMIT_AI_MUTATIONS=20
RATE_LIMIT_SYNC_MUTATIONS=10
RATE_LIMIT_EXECUTION_MUTATIONS=20
RATE_LIMIT_SUPPORT_MUTATIONS=12
RATE_LIMIT_OUTCOME_MUTATIONS=20
RATE_LIMIT_FORECAST_MUTATIONS=20
SUPPORT_MAX_MEASUREMENT_WINDOW_DAYS=90
DEMO_BOOTSTRAP_ENABLED=true
